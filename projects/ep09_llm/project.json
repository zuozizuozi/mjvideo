  "transitionSfx": { "kind": "swell", "vol": 0.18 },
  "output_name": "成片.mp4",
  "shots": [
    { "id": "s01", "scene": "vibe_chat_flow", "label": "头头是道", "music": "ambient_pad", "energy": 0.85, "energyTo": 0.9, "transition": "fade", "hold": 0.6,
      "lines": [ { "text": "你问它一个问题，" }, { "text": "它回答得头头是道。" }, { "text": "写诗、写代码、讲道理——" }, { "text": "可它其实，只会做**一件事**。", "hold": 0.6 } ] },
    { "id": "s02", "scene": "vibe_particle_title", "label": "标题", "music": "ambient_pad", "energy": 0.6, "energyTo": 0.6, "transition": "fade", "pre": 1.0, "hold": 0.4,
      "lines": [ { "text": "猜，下一个字。", "dur": 4.2 } ],
      "params": { "cursorUntil": 0, "blocks": [ { "line": 0, "size": 150, "y": 470, "font": "H", "color": "#f2efe6", "stay": true } ],
                  "extras": [ { "text": "N E X T   T O K E N", "y": 610, "size": 30, "after": 0, "delay": 1.6 } ] } },
    { "id": "s03", "scene": "vibe_prob_bars", "label": "概率", "music": "ambient_piano", "energy": 0.6, "energyTo": 0.7, "transition": "fade", "hold": 0.3,
      "lines": [ { "text": "「今天天气真」，后面接什么？" }, { "text": "好 62%　不错 21%　冷 9%……" }, { "text": "它挑一个，接上，再猜下一个。", "hold": 1.2 }, { "text": "一个字一个字，一整段话就这么**长**出来了。", "hold": 1.0 } ] },
    { "id": "s04", "scene": "vibe_dot_grid", "label": "疑问", "music": "ambient_piano", "energy": 0.25, "energyTo": 0.25, "transition": "fade", "pre": 0.6, "hold": 0.6,
      "lines": [ { "text": "可是，它凭什么**猜得准**？", "hold": 0.6 } ], "params": { "phase": "question" } },
    { "id": "s05", "scene": "vibe_dot_grid", "label": "参数", "music": "ambient_full", "energy": 0.65, "energyTo": 0.8, "transition": "fade", "hold": 0.8,
      "lines": [ { "text": "答案藏在这里。", "hold": 0.5 }, { "text": "几千亿个数字。", "hold": 0.4 }, { "text": "我们叫它——**参数**。" }, { "text": "每一个，都像一个小小的**旋钮**。", "hold": 1.0 } ], "params": { "phase": "reveal" } },
    { "id": "s06", "scene": "vibe_neural_net", "label": "神经网络", "music": "ambient_full", "energy": 0.8, "energyTo": 0.8, "transition": "fade", "hold": 0.8,
      "lines": [ { "text": "一个字进来，先变成一串数字，", "hold": 0.4 }, { "text": "穿过一层又一层，", "hold": 0.4 }, { "text": "每一层，都被这些旋钮**拧一下**，", "hold": 0.4 }, { "text": "最后变成——下一个字的**概率**。", "hold": 0.8 } ] },
    { "id": "s07", "scene": "vibe_dot_grid", "label": "随机", "music": "ambient_full", "energy": 0.7, "energyTo": 0.7, "transition": "fade", "hold": 0.6,
      "lines": [ { "text": "刚开始，所有旋钮都是**随机**的。" }, { "text": "它说出来的，全是乱码。", "hold": 0.6 } ], "params": { "phase": "chaos" } },
    { "id": "s08", "scene": "vibe_loss_valley", "label": "训练", "music": "ambient_lift", "energy": 0.7, "energyTo": 1.0, "transition": "fade", "hold": 1.0,
      "lines": [ { "text": "于是，给它看人类写下的文字——" }, { "text": "几万亿个字。", "hold": 0.6 }, { "text": "每猜一次，就算一下**差了多少**，", "hold": 0.6 }, { "text": "再把所有旋钮，往“少错一点”的方向，拧**一点点**。", "hold": 0.8 }, { "text": "一次，一次，又一次。", "hold": 1.6 } ] },
    { "id": "s09", "scene": "vibe_embedding_stars", "label": "词向量", "music": "ambient_arp", "energy": 0.7, "energyTo": 0.7, "transition": "fade", "hold": 1.0,
      "lines": [ { "text": "没有人教过它**语法**。" }, { "text": "也没有人告诉它，什么是**逻辑**。" }, { "text": "可为了猜得更准，它**自己**学会了。", "hold": 1.2 }, { "text": "国王 − 男人 + 女人 ≈ **女王**", "hold": 1.4 } ] },
    { "id": "s10", "scene": "vibe_attention_lines", "label": "注意力", "music": "ambient_arp", "energy": 0.75, "energyTo": 0.85, "transition": "fade", "hold": 1.0,
      "lines": [ { "text": "小猫没有跳上桌子，因为它太累了。" }, { "text": "读到「它」的时候，它会回头看——", "hold": 0.6 }, { "text": "「它」，指的是谁？", "hold": 0.8 }, { "text": "这叫**注意力**：每个字，都在看别的字。", "hold": 1.2 } ] },
    { "id": "s11", "scene": "vibe_dot_grid", "label": "懂吗", "music": "ambient_pad", "energy": 0.3, "energyTo": 0.3, "transition": "fade", "hold": 0.6,
      "lines": [ { "text": "所以，它真的**懂**吗？", "hold": 0.6 }, { "text": "没有人能完全回答。", "hold": 0.6 } ], "params": { "phase": "dim" } },
    { "id": "s12", "scene": "vibe_particle_figure", "label": "怎么来的", "music": "ambient_piano", "energy": 0.55, "energyTo": 0.85, "transition": "fade", "hold": 0.6,
      "lines": [ { "text": "但我们知道，它是怎么来的：" }, { "text": "从一片**混乱**开始，" }, { "text": "被纠正了几万亿次，" }, { "text": "每一次，只变好**一点点**。", "hold": 1.0 } ], "params": { "phase": "converge" } },
    { "id": "s13", "scene": "vibe_particle_figure", "label": "人也一样", "music": "ambient_lift", "energy": 0.9, "energyTo": 1.0, "transition": "fade", "hold": 0.8,
      "lines": [ { "text": "这么看，人学会一件事，" }, { "text": "好像也是这样：" }, { "text": "猜错，被纠正，再猜一次。", "hold": 1.0 } ], "params": { "phase": "neurons" } },
    { "id": "s14", "scene": "vibe_particle_title", "label": "收尾", "music": "ambient_lift", "energy": 1.0, "energyTo": 0.8, "transition": "fade", "pre": 0.8, "hold": 1.0,
      "lines": [ { "text": "智能，也许就是——", "dur": 2.6 }, { "text": "**不是一开始就懂，而是一次次被纠正。**", "dur": 4.6 }, { "text": "原理已简化 · 示意内容已标注", "dur": 2.4 } ],
      "params": { "from": "figure", "blocks": [ { "line": 0, "size": 96, "y": 400, "font": "H", "color": "#f2efe6", "stay": true }, { "line": 1, "size": 80, "y": 590, "font": "H", "color": "#f3c46b", "stay": true } ],
                  "captionY": 960, "captionSize": 30, "captionColor": "rgba(242,239,230,0.6)" } },
    { "id": "s15", "scene": "vibe_outro_note", "label": "彩蛋", "music": "ambient_outro", "energy": 0.35, "energyTo": 0.25, "pre": 0.8,
      "lines": [ { "text": "这条视频的每一帧，也是 AI 一行一行写出来的。", "dur": 4.2 } ] }
  ]
